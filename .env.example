# Copy to .env and fill in. Authentication is Entra ID only: run `az login` first. No API keys.

# Microsoft Foundry project (Overview page of the project in the Foundry portal)
PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# Azure AI Search: leave empty to use the search resource connected to the Foundry project
SEARCH_ENDPOINT=

# Your team, e.g. g1-t3 = group 1, team 3. Prefixes every index and memory scope.
PDFMEM_TEAM=g1-t1

# Snapshot model: foundry-te3s (cloud embeddings, recommended) or e5base (local, offline)
PDFMEM_MODEL=foundry-te3s
PDFMEM_CHUNKS_VARIANT=scalar
PDFMEM_GOLDEN=data/golden.jsonl

# azure (default) or simulator (only if Azure is unreachable: the trainer will tell you)
PDFMEM_BACKEND=azure
# PDFMEM_OFFLINE=1   # rule-based extraction instead of the model
